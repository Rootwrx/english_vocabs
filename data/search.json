[{"w":"bring","pos":"v.","ar":"جيب","def":"To take something or someone with you to a place.","l":"by_level__Basic_Vocabulary_A1A2___part1","i":0,"c":[["bring something with you","جيب شي حاجة معاك"],["bring someone along","جيب معاك شي واحد"],["bring something up","يفتح موضوع / يذكر شي حاجة"],["bring something back","يرجع شي حاجة"]]},{"w":"almost","pos":"adv.","ar":"تقريباً / شوية وكان","def":"Very close to something, but not completely.","l":"by_level__Basic_Vocabulary_A1A2___part1","i":1,"c":[["almost everyone","تقريباً الناس كاملين"],["almost always","تقريباً ديما"],["almost ready","تقريباً واجد"],["almost forgot","شوية وكنت نسيت"]]},{"w":"have fun","pos":"exp.","ar":"تسلى / تهنا","def":"To enjoy yourself and have a good time.","l":"by_level__Basic_Vocabulary_A1A2___part1","i":2,"c":[["Have fun!","تسلى! / الله يعطيك التسلية"],["Did you have fun?","واش تسليتي؟"],["have fun doing something","تسلى فاش كيدير شي حاجة"],["have fun with someone","تسلى مع شي واحد"]]},{"w":"behind","pos":"prep./adv.","ar":"من ورا / مورا","def":"At the back of something; later or slower than planned.","l":"by_level__Basic_Vocabulary_A1A2___part1","i":3,"c":[["behind the door","من ورا الباب"],["behind schedule","متأخرين على الوقت المحدد"],["fall behind","يتأخر / يبقى من ورا"],["leave something behind","يخلي شي حاجة / ينساها"]]},{"w":"move","pos":"v./n.","ar":"تنقل / حرك","def":"To go to a new place or position; to change where you live.","l":"by_level__Basic_Vocabulary_A1A2___part1","i":4,"c":[["move to a new city","تنقل لمدينة جديدة"],["move out","يخرج من الدار / يخلي الكراء"],["move on to something","يدوز لحاجة أخرى"],["move your car","حرك الطوموبيل ديالك"]]},{"w":"find","pos":"v.","ar":"لقى","def":"To see or get something you were looking for; to discover something.","l":"by_level__Basic_Vocabulary_A1A2___part1","i":5,"c":[["find out","يعرف / يكتاشف"],["find it hard to do something","كيلقاها صعيبة باش يدير شي حاجة"],["find a job","يلقى خدمة"],["find time to do something","يلقى الوقت باش يدير شي حاجة"]]},{"w":"people","pos":"n.","ar":"الناس","def":"More than one person.","l":"by_level__Basic_Vocabulary_A1A2___part1","i":6,"c":[["people say","كيقولو الناس"],["a lot of people","بزاف د الناس"],["most people","أغلب الناس"],["young people","الشباب"]]},{"w":"make a mistake","pos":"exp.","ar":"يغلط / دير غلطة","def":"To do something wrong without wanting to.","l":"by_level__Basic_Vocabulary_A1A2___part1","i":7,"c":[["make a mistake","يغلط"],["make mistakes","يغلط (بزاف د المرات)"],["make a mistake in something","يغلط ف شي حاجة"],["Sorry, my mistake","سمح ليا، غلطتي"]]},{"w":"begin","pos":"v.","ar":"بدا","def":"To start to do something, or to start happening.","l":"by_level__Basic_Vocabulary_A1A2___part1","i":8,"c":[["begin with something","يبدا ب شي حاجة"],["begin to do something","يبدا كيدير شي حاجة"],["to begin with","فالأول / أول حاجة"],["What time does it begin?","فأنهي ساعة غادي يبدا؟"]]},{"w":"outside","pos":"adv./prep.","ar":"برا","def":"Not inside a building or place.","l":"by_level__Basic_Vocabulary_A1A2___part1","i":9,"c":[["go outside","خرج لبرا"],["outside the building","برا البناية"],["outside office hours","برا أوقات الخدمة"],["It's cold outside","الجو بارد برا"]]}]